// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userA   User   @relation("UserA", fields: [userAId], references: [id])
  userAId String
  userB   User   @relation("UserB", fields: [userBId], references: [id])
  userBId String

  messages Message[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  avatarUrl String?
  password  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sentMessages   Message[]      @relation("SentMessages")
  conversationsA Conversation[] @relation("UserA")
  conversationsB Conversation[] @relation("UserB")

  reactions MessageReaction[]

  @@index([username], name: "idx_username")
  @@map("users")
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  emoji     String
  createdAt DateTime @default(now())

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([messageId, userId, emoji])
  @@index([messageId], name: "idx_messageId")
  @@index([userId], name: "idx_userId")
  @@map("reactions")
}
