# Example of Docker infrastructure .env file
#
# This file contains environment variables used ONLY by Docker / Docker Compose
# (e.g. database containers, ports, service configuration).
#
# These variables are NOT application runtime variables and MUST NOT include
# secrets such as JWT tokens, API keys, or application-specific configuration.
#
# Copy this file to .env and adjust the values for your local development setup.
# This example file should never be used in production.

# ychat-pg
POSTGRES_PORT=5432
POSTGRES_USER="root"
POSTGRES_PASSWORD="password"
POSTGRES_DB="postgres"

# ychat-api
API_PORT=4000

# ychat-web
WEB_PORT=3000